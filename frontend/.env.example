VITE_API_URL=http://127.0.0.1:8000

# Public, referrer-restricted Google Maps Embed API key (restrict it to this
# site's domain(s) in the Google Cloud Console — it is not a secret).
VITE_GOOGLE_MAPS_API_KEY=

# Public address of the website (absolute URLs for social previews, canonical links).
# Set it to the real domain before building for production.
VITE_SITE_URL=http://localhost:5173
