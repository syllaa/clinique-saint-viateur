# Variables of docker-compose.yml. Copy to .env and fill in EVERY value.
# Never commit the real .env (it is git-ignored).

# Public address of the website, with https:// and without trailing slash.
SITE_URL=https://www.exemple-clinique.ci

# Port on which the website is published on the server (put HTTPS in front).
WEB_PORT=8080

# Database (generate long random passwords, e.g. `openssl rand -base64 32`).
DB_NAME=clinique_saint_viateur
DB_USER=clinique
DB_PASSWORD=
DB_ROOT_PASSWORD=

# JWT signing key: 64+ random characters (`openssl rand -hex 48`).
SECRET_KEY=

# First administrator, created only if the database has no user yet.
# At least 10 characters with letters and digits; change it again from
# Administration > Sécurité after the first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Optional: Google Maps embed on the "Nous rejoindre" page.
GOOGLE_MAPS_API_KEY=

# Days of automatic database backups kept on the server.
BACKUP_RETENTION_DAYS=14
